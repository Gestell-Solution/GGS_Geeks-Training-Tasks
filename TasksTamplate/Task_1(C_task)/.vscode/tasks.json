{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build Assignment_1 (file.c + main.c)",
            "command": "C:\\msys64\\mingw64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-Wall",
                "-Wextra",
                "${workspaceFolder}\\file.c",
                "${workspaceFolder}\\main.c",
                "-o",
                "${workspaceFolder}\\app.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds the merged project (file.c + main.c) into app.exe."
        }
    ],
    "version": "2.0.0"
}
